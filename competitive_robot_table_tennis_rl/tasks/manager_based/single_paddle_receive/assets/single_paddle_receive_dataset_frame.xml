<?xml version="1.0" encoding="utf-8"?>
<mujoco model="single_paddle_receive_dataset_frame">
  <compiler angle="radian" autolimits="true"/>

  <option density="1.225"
          viscosity="1.8e-5"
          wind="0 0 0"
          integrator="implicitfast"
          timestep="0.001"
          cone="elliptic"
          iterations="80"
          solver="Newton"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.3 0.3 0.3"/>
    <map znear="0.01" zfar="30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.65 0.8" rgb2="0.05 0.05 0.07" width="256" height="256"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.9 0.9 0.9" rgb2="0.8 0.8 0.8" markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.25"/>
    <material name="table_green" rgba="0.27 0.51 0.14 1" reflectance="0.15"/>
    <material name="line_white" rgba="1 1 1 1"/>
    <material name="net_white" rgba="1 1 1 0.55"/>
    <material name="ball_orange" rgba="0.98 0.70 0.015 1" reflectance="0.25"/>
    <material name="paddle_red" rgba="0.85 0.03 0.02 1" reflectance="0.15"/>
    <material name="paddle_black" rgba="0.02 0.02 0.02 1" reflectance="0.15"/>
    <material name="paddle_wood" rgba="0.60 0.36 0.16 1" reflectance="0.08"/>
    <material name="paddle_collision_mat" rgba="1 0 0 0.22"/>
  </asset>

  <default>
    <default class="paddle_joint">
      <joint damping="1.0" armature="0.002" frictionloss="0.001"/>
    </default>
    <default class="paddle_motor">
      <position ctrllimited="true" forcelimited="true" gear="1"/>
    </default>
  </default>

  <worldbody>
    <light name="main_light" pos="0 -2.5 4" dir="0 0 -1" diffuse="1 1 1" specular="0.5 0.5 0.5"/>
    <geom name="floor" type="plane" pos="0 0 -0.76" size="5 5 0.1" material="groundplane"/>

    <!--
      Keep the dataset-frame convention (table surface at world z = 0), but
      mirror the contact-relevant setup from table_tennis.xml:
      - same ball geom contact tuning
      - same ball-table pair parameters
      - same extra non-colliding overlay geom around the table surface
    -->
    <body name="table" pos="0 0 0">
      <geom name="geom_table" type="box" pos="0 0 -0.02" size="0.7625 1.37 0.02" material="table_green"/>
      <geom name="geom_table_overlay"
            type="box"
            pos="0 0 -0.021"
            size="0.7635 1.371 0.02"
            contype="0"
            conaffinity="0"
            group="1"
            density="0"
            rgba="0 0 0 1"/>

      <geom name="line_left" type="box" pos="-0.755 0 0.001" size="0.006 1.37 0.001" material="line_white" contype="0" conaffinity="0"/>
      <geom name="line_right" type="box" pos="0.755 0 0.001" size="0.006 1.37 0.001" material="line_white" contype="0" conaffinity="0"/>
      <geom name="line_near" type="box" pos="0 -1.363 0.001" size="0.7625 0.006 0.001" material="line_white" contype="0" conaffinity="0"/>
      <geom name="line_far" type="box" pos="0 1.363 0.001" size="0.7625 0.006 0.001" material="line_white" contype="0" conaffinity="0"/>
      <geom name="line_center" type="box" pos="0 0 0.002" size="0.003 1.37 0.001" material="line_white" contype="0" conaffinity="0"/>

      <geom name="geom_net" type="box" pos="0 0 0.07625" size="0.915 0.005 0.07625" material="net_white"/>
      <geom name="net_band" type="box" pos="0 0 0.154" size="0.915 0.006 0.004" material="line_white" contype="0" conaffinity="0"/>
    </body>

    <body name="ball" pos="0.0 1.35 0.30">
      <freejoint name="ball_freejoint"/>
      <inertial pos="0 0 0" mass="2.7e-3" diaginertia="7.2e-7 7.2e-7 7.2e-7"/>
      <geom name="geom_ball"
            type="sphere"
            size="0.02"
            shellinertia="false"
            fluidcoef="0.235 0.25 0.0 1.0 1.0"
            fluidshape="ellipsoid"
            solref="-100000 -0"
            group="1"
            material="ball_orange"/>
      <site name="ball_site" pos="0 0 0" size="0.006" rgba="1 0 0 1"/>
    </body>

    <body name="paddle_x_slide" pos="0 -0.90 0">
      <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
      <joint name="paddle_x" type="slide" axis="1 0 0" class="paddle_joint"/>
      <body name="paddle_y_slide" pos="0 0 0">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="paddle_y" type="slide" axis="0 1 0" class="paddle_joint"/>
        <body name="paddle_z_slide" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
          <joint name="paddle_z" type="slide" axis="0 0 1" class="paddle_joint"/>
          <body name="paddle_roll_body" pos="0 0 0">
            <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
            <joint name="paddle_roll" type="hinge" axis="1 0 0" class="paddle_joint"/>
            <body name="paddle_pitch_body" pos="0 0 0">
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
              <joint name="paddle_pitch" type="hinge" axis="0 1 0" class="paddle_joint"/>
              <body name="paddle_yaw_body" pos="0 0 0">
                <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
                <joint name="paddle_yaw" type="hinge" axis="0 0 1" class="paddle_joint"/>

                <body name="paddle" pos="0 0 0">
                  <site name="paddle_center_site" pos="0 0 0" size="0.012" rgba="0 1 0 1"/>
                  <site name="paddle_face_site" pos="0 0.010 0" size="0.006" rgba="0 0 1 1"/>

                  <geom name="paddle_collision"
                        type="cylinder"
                        pos="0 0 0"
                        quat="0.7071068 0.7071068 0 0"
                        size="0.085 0.010"
                        mass="0.08"
                        material="paddle_collision_mat"/>

                  <geom name="paddle_red_face"
                        type="cylinder"
                        pos="0 0.011 0"
                        quat="0.7071068 0.7071068 0 0"
                        size="0.085 0.001"
                        material="paddle_red"
                        contype="0" conaffinity="0"/>
                  <geom name="paddle_black_face"
                        type="cylinder"
                        pos="0 -0.011 0"
                        quat="0.7071068 0.7071068 0 0"
                        size="0.085 0.001"
                        material="paddle_black"
                        contype="0" conaffinity="0"/>
                  <geom name="paddle_handle"
                        type="capsule"
                        fromto="0 0 0 0 -0.20 -0.02"
                        size="0.018"
                        mass="0.04"
                        material="paddle_wood"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <camera name="side_view" pos="3.0 -3.0 1.8" xyaxes="0.707 0.707 0 -0.29 0.29 0.912"/>
    <camera name="receiver_view" pos="0 -2.5 1.2" xyaxes="1 0 0 0 0.3 0.95"/>
    <camera name="top_view" pos="0 0 4.2" xyaxes="1 0 0 0 1 0"/>
  </worldbody>

  <contact>
    <pair geom1="geom_ball" geom2="geom_table"
          solref="-1000000 -17"
          friction="0.1 0.1 0.005 0.0001 0.0001"
          solimp="0.98 0.99 0.001 0.5 2"
          solreffriction="-0.0 -200.0"/>
    <pair geom1="geom_ball" geom2="paddle_collision"
          solref="-500000 -24"
          friction="0.7 0.7 0.012 0.0005 0.0005"
          solimp="0.96 0.995 0.001 0.5 2"
          solreffriction="-0.0 -180.0"/>
  </contact>

  <actuator>
    <position name="paddle_x_pos" joint="paddle_x" kp="500" ctrlrange="-0.60 0.60" class="paddle_motor" forcerange="-250 250"/>
    <position name="paddle_y_pos" joint="paddle_y" kp="500" ctrlrange="-1.25 -0.05" class="paddle_motor" forcerange="-250 250"/>
    <position name="paddle_z_pos" joint="paddle_z" kp="600" ctrlrange="0.05 0.60" class="paddle_motor" forcerange="-300 300"/>
    <position name="paddle_roll_pos" joint="paddle_roll" kp="80" ctrlrange="-3.15 3.15" class="paddle_motor" forcerange="-40 40"/>
    <position name="paddle_pitch_pos" joint="paddle_pitch" kp="80" ctrlrange="-3.15 3.15" class="paddle_motor" forcerange="-40 40"/>
    <position name="paddle_yaw_pos" joint="paddle_yaw" kp="80" ctrlrange="-3.15 3.15" class="paddle_motor" forcerange="-40 40"/>
  </actuator>
</mujoco>
