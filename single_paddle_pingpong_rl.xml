<?xml version="1.0" encoding="utf-8"?>
<mujoco model="single_paddle_pingpong_rl">
  <!--
    Standalone single-paddle ping-pong RL scene.

    Design intent:
      - One paddle is controlled by 6 bounded joints: x/y/z + roll/pitch/yaw.
      - The ball is a free body with ping-pong-like mass, radius, drag, and table contact.
      - Contact is pair-specific: ball-table and ball-paddle are tuned separately.
      - This is useful before training OpenArm: learn racket interception/return logic first.
  -->

  <compiler angle="radian" autolimits="true"/>

  <option density="1.225"
          viscosity="1.8e-5"
          wind="0 0 0"
          integrator="implicitfast"
          timestep="0.001"
          cone="elliptic"
          iterations="80"
          solver="Newton"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.3 0.3 0.3"/>
    <map znear="0.01" zfar="30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.65 0.8" rgb2="0.05 0.05 0.07" width="256" height="256"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.9 0.9 0.9" rgb2="0.8 0.8 0.8" markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.25"/>
    <material name="table_green" rgba="0.27 0.51 0.14 1" reflectance="0.15"/>
    <material name="line_white" rgba="1 1 1 1"/>
    <material name="net_white" rgba="1 1 1 0.55"/>
    <material name="ball_orange" rgba="0.98 0.70 0.015 1" reflectance="0.25"/>
    <material name="paddle_red" rgba="0.85 0.03 0.02 1" reflectance="0.15"/>
    <material name="paddle_black" rgba="0.02 0.02 0.02 1" reflectance="0.15"/>
    <material name="paddle_wood" rgba="0.60 0.36 0.16 1" reflectance="0.08"/>
    <material name="paddle_collision_mat" rgba="1 0 0 0.22"/>
  </asset>

  <default>
    <default class="paddle_joint">
      <joint damping="1.0" armature="0.002" frictionloss="0.001"/>
    </default>
    <default class="paddle_motor">
      <motor ctrllimited="true" forcelimited="true" gear="1"/>
    </default>
  </default>

  <worldbody>
    <light name="main_light" pos="0 -2.5 4" dir="0 0 -1" diffuse="1 1 1" specular="0.5 0.5 0.5"/>
    <geom name="floor" type="plane" pos="0 0 0" size="5 5 0.1" material="groundplane" contype="0" conaffinity="0"/>

    <!-- Real table-tennis table: full size 2.74 m x 1.525 m. Table surface height = 0.76 m. -->
    <body name="table" pos="0 0 0">
      <geom name="geom_table" type="box" pos="0 0 0.76" size="1.37 0.7625 0.02" material="table_green"/>

      <!-- visual table lines; no collision -->
      <geom name="line_left" type="box" pos="0 0.755 0.781" size="1.37 0.006 0.001" material="line_white" contype="0" conaffinity="0"/>
      <geom name="line_right" type="box" pos="0 -0.755 0.781" size="1.37 0.006 0.001" material="line_white" contype="0" conaffinity="0"/>
      <geom name="line_near" type="box" pos="1.363 0 0.781" size="0.006 0.7625 0.001" material="line_white" contype="0" conaffinity="0"/>
      <geom name="line_far" type="box" pos="-1.363 0 0.781" size="0.006 0.7625 0.001" material="line_white" contype="0" conaffinity="0"/>
      <geom name="line_center" type="box" pos="0 0 0.782" size="1.37 0.003 0.001" material="line_white" contype="0" conaffinity="0"/>

      <!-- simple net at x=0 -->
      <geom name="geom_net" type="box" pos="0 0 0.85625" size="0.005 0.915 0.07625" material="net_white"/>
      <geom name="net_band" type="box" pos="0 0 0.934" size="0.006 0.915 0.004" material="line_white" contype="0" conaffinity="0"/>
    </body>

    <!-- Ball starts above receiver side. Reset code should overwrite qpos/qvel from serves/rallies. -->
    <body name="ball" pos="-0.65 0.0 1.10">
      <freejoint name="ball_freejoint"/>
      <inertial pos="0 0 0" mass="2.7e-3" diaginertia="7.2e-7 7.2e-7 7.2e-7"/>
      <geom name="geom_ball"
            type="sphere"
            size="0.02"
            shellinertia="false"
            fluidcoef="0.235 0.25 0.0 1.0 1.0"
            fluidshape="ellipsoid"
            group="1"
            material="ball_orange"/>
      <site name="ball_site" pos="0 0 0" size="0.006" rgba="1 0 0 1"/>
    </body>

    
    <body name="paddle_x_slide" pos="-1.6 0 0" >
      
      <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
      <joint name="paddle_x" type="slide" axis="1 0 0" class="paddle_joint"/>
      <body name="paddle_y_slide" pos="0 0 0">
        
      <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
      <joint name="paddle_y" type="slide" axis="0 1 0" class="paddle_joint"/>
        <body name="paddle_z_slide" pos="0 0 0">
          
      <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
      <joint name="paddle_z" type="slide" axis="0 0 1" class="paddle_joint"/>
          <body name="paddle_roll_body" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
            <joint name="paddle_roll" type="hinge" axis="1 0 0"  class="paddle_joint"/>
            <body name="paddle_pitch_body" pos="0 0 0">
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
              <joint name="paddle_pitch" type="hinge" axis="0 1 0" class="paddle_joint"/>
              <body name="paddle_yaw_body" pos="0 0 0">
                <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
                <joint name="paddle_yaw" type="hinge" axis="0 0 1" class="paddle_joint"/>

                <!-- Paddle body frame. Its origin is the RL end-effector/paddle control point. -->
                <body name="paddle" pos="0 0 0" quat="0.7071068 0 0.7071068 0">
                  <site name="paddle_center_site" pos="0 0 0" size="0.012" rgba="0 1 0 1"/>
                  <site name="paddle_face_site" pos="0.008 0 0" size="0.006" rgba="0 0 1 1"/>

                  <!-- Paddle blade. Axis is local x after the quat above. Collision is slightly thick for robust fast-ball contact. -->
                  <geom name="paddle_collision"
                        type="cylinder"
                        pos="0 0 0"
                        quat="0.7071068 0 0.7071068 0"
                        size="0.085 0.010"
                        mass="0.08"
                        material="paddle_collision_mat"/>

                  <!-- Visual red/black rubber surfaces; no collision. -->
                  <geom name="paddle_red_face"
                        type="cylinder"
                        pos="0.011 0 0"
                        quat="0.7071068 0 0.7071068 0"
                        size="0.085 0.001"
                        material="paddle_red"
                        contype="0" conaffinity="0"/>
                  <geom name="paddle_black_face"
                        type="cylinder"
                        pos="-0.011 0 0"
                        quat="0.7071068 0 0.7071068 0"
                        size="0.085 0.001"
                        material="paddle_black"
                        contype="0" conaffinity="0"/>

                  <!-- Handle, mostly visual and low-priority collision. -->
                  <geom name="paddle_handle"
                        type="capsule"
                        fromto="0 -0.085 0 0 -0.22 0"
                        size="0.018"
                        mass="0.04"
                        material="paddle_wood"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <camera name="side_view" pos="3.0 -3.0 1.8" xyaxes="0.707 0.707 0 -0.29 0.29 0.912"/>
    <camera name="receiver_view" pos="-2.2 0 1.25" xyaxes="0 -1 0 0.2 0 0.98"/>
    <camera name="top_view" pos="0 0 4.2" xyaxes="1 0 0 0 1 0"/>
  </worldbody>

  <!-- Pair-specific contacts. This follows the uploaded table_tennis.xml style for ball-table. -->
  <contact>
    <pair geom1="geom_ball" geom2="geom_table"
          solref="-1000000 -17"
          friction="0.1 0.1 0.005 0.0001 0.0001"
          solimp="0.98 0.99 0.001 0.5 2"
          solreffriction="-0.0 -200.0"/>

    <!-- Paddle is softer than table to avoid huge impulses into the controllable body during RL. -->
    <pair geom1="geom_ball" geom2="paddle_collision"
          solref="-500000 -24"
          friction="0.7 0.7 0.012 0.0005 0.0005"
          solimp="0.96 0.995 0.001 0.5 2"
          solreffriction="-0.0 -180.0"/>
  </contact>

  <actuator>
    <!-- Position actuators for easy RL action mapping. Recommended action = target joint position residual/clipped target. -->
    <position name="paddle_x_pos" joint="paddle_x" kp="500" ctrlrange="-0.50 0.65" class="paddle_motor" forcerange="-250 250"/>
    <position name="paddle_y_pos" joint="paddle_y" kp="500" ctrlrange="-0.70 0.70" class="paddle_motor" forcerange="-250 250"/>
    <position name="paddle_z_pos" joint="paddle_z" kp="600" ctrlrange="0.78 1.55" class="paddle_motor" forcerange="-300 300"/>
    <position name="paddle_roll_pos" joint="paddle_roll" kp="80" ctrlrange="-3.15 3.15" class="paddle_motor" forcerange="-40 40"/>
    <position name="paddle_pitch_pos" joint="paddle_pitch" kp="80" ctrlrange="-3.15 3.15" class="paddle_motor" forcerange="-40 40"/>
    <position name="paddle_yaw_pos" joint="paddle_yaw" kp="80" ctrlrange="-3.15 3.15" class="paddle_motor" forcerange="-40 40"/>
  </actuator>

  <sensor>
    <framepos name="ball_pos" objtype="site" objname="ball_site"/>
    <framelinvel name="ball_linvel" objtype="site" objname="ball_site"/>
    <frameangvel name="ball_angvel" objtype="site" objname="ball_site"/>
    <framepos name="paddle_pos" objtype="site" objname="paddle_center_site"/>
    <framequat name="paddle_quat" objtype="site" objname="paddle_center_site"/>
    <framelinvel name="paddle_linvel" objtype="site" objname="paddle_center_site"/>
    <frameangvel name="paddle_angvel" objtype="site" objname="paddle_center_site"/>
    <jointpos name="paddle_qpos" joint="paddle_x"/>
    <jointpos name="paddle_y_qpos" joint="paddle_y"/>
    <jointpos name="paddle_z_qpos" joint="paddle_z"/>
    <jointpos name="paddle_roll_qpos" joint="paddle_roll"/>
    <jointpos name="paddle_pitch_qpos" joint="paddle_pitch"/>
    <jointpos name="paddle_yaw_qpos" joint="paddle_yaw"/>
  </sensor>

  <keyframe>
  <!--0 0 0.9 1.57 1.57 0 --> 
    <!-- qpos order: ball freejoint(7), then paddle_x/y/z/roll/pitch/yaw. -->
    <key name="serve_easy"
         qpos="-0.25 0.00 1.15 1 0 0 0  -0.95 0.00 1.05 0.00 0.00 0.00"
         qvel="-1.7 0.0 -0.8 0 0 0  0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
